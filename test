-- HMAC-SHA256 signing using Roblox's built-in HMAC (available in executors)
local function hmacSHA256(key, message)
    -- Try executor-provided crypto first
    local ok, result = pcall(function()
        return crypt and crypt.hmac and crypt.hmac(crypt.sha256, message, key)
    end)
    if ok and result then return result end
    -- Fallback: use syn.crypt or similar
    local ok2, result2 = pcall(function()
        return syn and syn.crypt and syn.crypt.hmac(syn.crypt.sha256, message, key)
    end)
    if ok2 and result2 then return result2 end
    return nil
end

local function base64UrlDecode(s)
    s = s:gsub("-", "+"):gsub("_", "/")
    local pad = (4 - #s % 4) % 4
    s = s .. string.rep("=", pad)
    local ok, result = pcall(function()
        return crypt and crypt.base64decode and crypt.base64decode(s)
    end)
    if ok and result then return result end
    return s -- fallback raw
end

local function makeNonce()
    return HttpService:GenerateGUID(false):gsub("-", ""):sub(1, 16)
end

local function doRequest(url, method, headers, body)
    local result = nil
    local done = false

    task.spawn(function()
        local ok, res
        if request then
            ok, res = pcall(function()
                return request({ Url = url, Method = method, Headers = headers, Body = body or "" })
            end)
            if ok and res then result = res.Body end
        end
        -- Fallback to HttpService if request not available or failed
        if not result then
            ok, res = pcall(function()
                if method == "POST" then
                    return HttpService:PostAsync(url, body or "", Enum.HttpContentType.ApplicationJson, false)
                else
                    return HttpService:GetAsync(url, false)
                end
            end)
            if ok and res then result = res end
        end
        done = true
    end)

    -- Wait max 8 seconds per request
    local elapsed = 0
    while not done and elapsed < 8 do
        task.wait(0.1)
        elapsed = elapsed + 0.1
    end

    return result
end

local function startPopHeartbeat(key)
    task.spawn(function()
        -- Step 1: Bootstrap — get accessToken + popKey
        local bootstrapBody = HttpService:JSONEncode({
            key = key,
            hwid = HWID,
            requestId = HttpService:GenerateGUID(false)
        })
        local bootstrapRaw = doRequest(
            NEBUL_BASE .. "/api/v1/auth/verify",
            "POST",
            {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. NEBUL_VERIFY_TOKEN
            },
            bootstrapBody
        )
        if not bootstrapRaw then return end
        local ok, bootstrap = pcall(HttpService.JSONDecode, HttpService, bootstrapRaw)
        if not ok or not bootstrap or not bootstrap.valid then return end

        local accessToken = bootstrap.accessToken
        local popKey = base64UrlDecode(bootstrap.popKey or "")
        if not accessToken or not popKey then return end

        -- Step 2: Heartbeat loop using PoP session
        while true do
            task.wait(HEARTBEAT_INTERVAL)
            pcall(function()
                local path = "/api/v1/keys/verify"
                local method = "POST"
                local timestamp = tostring(math.floor(os.time() * 1000))
                local nonce = makeNonce()
                local body = HttpService:JSONEncode({
                    key = key,
                    requestId = HttpService:GenerateGUID(false)
                })
                -- SHA256 of body
                local bodySha = ""
                pcall(function()
                    bodySha = crypt and crypt.sha256 and crypt.sha256(body) or ""
                end)
                -- Canonical string: METHOD\nPATH\nTIMESTAMP_MS\nNONCE\nSHA256_HEX(BODY)
                local canonical = method .. "\n" .. path .. "\n" .. timestamp .. "\n" .. nonce .. "\n" .. bodySha
                -- Sign with popKey
                local signature = hmacSHA256(popKey, canonical) or ""

                doRequest(
                    NEBUL_BASE .. path,
                    method,
                    {
                        ["Content-Type"] = "application/json",
                        ["Authorization"] = "Bearer " .. accessToken,
                        ["X-Timestamp"] = timestamp,
                        ["X-Nonce"] = nonce,
                        ["X-Signature"] = signature,
                        ["X-Hwid"] = HWID
                    },
                    body
                )
            end)
        end
    end)
end

local function validateKey(key)
    if not key or #key < 5 then return false, "No key provided" end

    -- mk_live_ keys (NebulAuth) are case-sensitive, NOFEAR- keys are uppercase
    local sendKey = key:match("^mk_") and key or key:upper()
    local body = HttpService:JSONEncode({ key = sendKey, hwid = HWID, license_key = sendKey })

    -- Try free key endpoint first (handles both mk_live_ and NOFEAR- keys)
    local raw = httpPost(KEY_SERVER .. "/api/key/validate", body)
    if raw then
        local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
        if ok and decoded then
            if decoded.valid then
                local expiresAt = tonumber(decoded.expires_at)
                if expiresAt and expiresAt > 0 then
                    local diff  = math.max(0, math.floor(expiresAt / 1000) - os.time())
                    local hours = math.floor(diff / 3600)
                    local mins  = math.floor((diff % 3600) / 60)
                    return true, string.format("Key valid - expires in %dh %dm", hours, mins)
                else
                    return true, "Key valid"
                end
            end
            -- If free key failed, try premium key endpoint
            local raw2 = httpPost(KEY_SERVER .. "/api/verify", body)
            if raw2 then
                local ok2, dec2 = pcall(HttpService.JSONDecode, HttpService, raw2)
                if ok2 and dec2 and dec2.success then
                    local plan = (dec2.user and dec2.user.plan) or dec2.plan or "premium"
                    return true, "Premium key valid - " .. plan:upper() .. " plan"
                end
                -- Return original free key error
                return false, decoded.error or "Invalid or expired key"
            end
            return false, decoded.error or "Invalid or expired key"
        end
    end

    warn("[NoFear] Could not reach server")
    return false, "Could not reach server. Check your connection."
end


