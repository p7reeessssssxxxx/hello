local function httpPost(url, body)
    -- Try executor request() first
    if request then
        local ok, res = pcall(request, { Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body or "" })
        if ok and res and res.Body and #res.Body > 0 then
            return res.Body
        end
    end

    -- Try http_request (some executors use this)
    if http_request then
        local ok, res = pcall(http_request, { Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body or "" })
        if ok and res and res.Body and #res.Body > 0 then
            return res.Body
        end
    end

    -- Try syn.request (Synapse)
    if syn and syn.request then
        local ok, res = pcall(syn.request, { Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body or "" })
        if ok and res and res.Body and #res.Body > 0 then
            return res.Body
        end
    end

    -- Fallback: HttpService:PostAsync
    local ok, res = pcall(function()
        return HttpService:PostAsync(url, body or "", Enum.HttpContentType.ApplicationJson, false)
    end)
    if ok and res and #res > 0 then return res end

    return nil
end

